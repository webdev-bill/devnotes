# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is gitignored — docker-compose.yml reads these to configure
# the db, backend, and frontend containers. Nothing here is a real secret.

# --- Database (shared by the "db" and "backend" services) ---
DB_DATABASE=devnotes
DB_USERNAME=devnotes
DB_PASSWORD=changeme
DB_PORT=5432

# --- Backend (Laravel) ---
# Host port that maps to the container's port 8000.
APP_PORT=8000

# --- Frontend (React/Vite) ---
# Host port that maps to the Vite dev server's port 5173.
FRONTEND_PORT=5173
# The browser calls the API directly at this URL, so it must be reachable
# from your machine (not the internal Docker network name "backend").
VITE_API_URL=http://localhost:8000/api
