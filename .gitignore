# --- Environment files (never commit secrets) ---
.env
.env.production
.env.*.local
.env.local

# --- Laravel (backend/) ---
backend/vendor/
backend/storage/*.key
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore

# --- React / Node (frontend/) ---
frontend/node_modules/
frontend/dist/

# --- Backups, dumps and key material (never commit, even encrypted) ---
# restore-db.sh reads a manually downloaded backup from the repo root, and
# gitleaks can't see inside an encrypted dump, so these are ignored by name.
*.gpg
*.dump
*.dump.gz
*.sql
*.sql.gz
!docker/postgres-init/*.sql
*.pem
*.key
id_rsa*
id_ed25519*

# --- General ---
.DS_Store
*.log
