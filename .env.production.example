# Copy this file to ".env.production" ON THE SERVER and fill in real values.
# ".env.production" must never be committed — it holds production secrets.
# Used with: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# --- Domain / TLS ---
DOMAIN=devnotes.billandrewsallao.com
# Let's Encrypt sends expiry/registration notices here.
ACME_EMAIL=you@example.com

# --- Database (shared by "db" and "backend") ---
DB_DATABASE=devnotes
DB_USERNAME=devnotes
# Generate a real secret — do not reuse the dev password.
DB_PASSWORD=changeme

# --- Backend (Laravel) ---
APP_NAME=devnotes
# Generate on the server after the first build (don't invent this value by hand):
#   docker compose -f docker-compose.prod.yml run --rm backend php artisan key:generate --show
# then paste the output (including the "base64:" prefix) here.
APP_KEY=

# --- Backend logging (optional — all four have working defaults in
# docker-compose.prod.yml, uncomment only to override one) ---
# LOG_CHANNEL=stack
# LOG_STACK=single
# LOG_LEVEL=debug
# LOG_DEPRECATIONS_CHANNEL=null

# --- Frontend ---
# Relative, not absolute — in production frontend and backend share one
# domain (Traefik routes /api to backend, everything else to frontend), so
# this doesn't need to know a hostname at all.
VITE_API_URL=/api

# --- Backups (scripts/backup-db.sh, scripts/restore-db.sh) ---
# Scoped, write-only B2 application key — not the master key. It only needs
# permission to upload into one bucket; it should never be able to list,
# download, or delete objects, so a leak of this key can't expose or erase
# existing backups.
B2_APPLICATION_KEY_ID=changeme
B2_APPLICATION_KEY=changeme
B2_BUCKET_NAME=changeme
# Not currently used by either script (b2 file upload/download take the
# bucket name, not its ID) — kept here for reference when looking the
# bucket up in the B2 console.
B2_BUCKET_ID=changeme
# Symmetric encryption passphrase for backup-db.sh/restore-db.sh. Generate a
# real random secret — do not reuse any other password in this file.
BACKUP_ENCRYPTION_PASSPHRASE=changeme

# --- Note/blog-post images (Backblaze B2, S3-compatible API) ---
# Separate bucket ("devnotes-images-webdevbill") and separate key from the
# backup key above. Unlike the backup key, this one needs read+delete — cover
# image replace deletes the superseded object from B2, and the proxy route
# (GET /api/images/{image}) reads bytes back out to serve them. Scope it to
# this one bucket only, not the account master key.
B2_IMAGES_KEY_ID=changeme
B2_IMAGES_APPLICATION_KEY=changeme
B2_IMAGES_BUCKET=changeme
B2_IMAGES_BUCKET_ID=changeme
# e.g. us-west-004 — must match the bucket's actual region, visible in the B2 console.
B2_IMAGES_REGION=changeme
# e.g. https://s3.us-west-004.backblazeb2.com — same region as above.
B2_IMAGES_ENDPOINT=changeme
