# Copy this file to ".env.production" ON THE SERVER and fill in real values.
# ".env.production" must never be committed — it holds production secrets.
# Used with: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# --- Domain / TLS ---
DOMAIN=devnotes.billandrewsallao.com
# Let's Encrypt sends expiry/registration notices here.
ACME_EMAIL=you@example.com

# --- Database (shared by "db" and "backend") ---
DB_DATABASE=devnotes
DB_USERNAME=devnotes
# Generate a real secret — do not reuse the dev password.
DB_PASSWORD=changeme

# --- Backend (Laravel) ---
APP_NAME=devnotes
# Generate on the server after the first build (don't invent this value by hand):
#   docker compose -f docker-compose.prod.yml run --rm backend php artisan key:generate --show
# then paste the output (including the "base64:" prefix) here.
APP_KEY=

# --- Frontend ---
# Relative, not absolute — in production frontend and backend share one
# domain (Traefik routes /api to backend, everything else to frontend), so
# this doesn't need to know a hostname at all.
VITE_API_URL=/api
